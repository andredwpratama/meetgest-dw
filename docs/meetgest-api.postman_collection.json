{
  "info": {
    "name": "Meetgest API",
    "description": "Full coverage of the Meeting Transcript Processor API.\n\nRun in order — POST /process captures meetingId, action-item IDs, and key-decision IDs automatically into collection variables so every downstream request just works.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:8787",  "type": "string" },
    { "key": "meetingId",     "value": "",                       "type": "string" },
    { "key": "actionItemId",  "value": "",                       "type": "string" },
    { "key": "keyDecisionId", "value": "",                       "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok true', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.ok).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Process Transcript",
      "item": [
        {
          "name": "POST /api/process — happy path",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/process",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q2 Campaign Review\",\n  \"transcript\": \"Sarah: Good morning everyone. Today we are reviewing the Q2 Meta campaign performance and deciding on budget reallocation for Q3.\\n\\nJohn: The Meta ads underperformed by 15% against our ROAS target. We need to pause the current creatives and launch new ones.\\n\\nSarah: Agreed. Let us pause Google Ads until new creatives are approved. John, can you prepare the new creative brief by Friday?\\n\\nJohn: Sure, I will have the brief ready by Friday EOD.\\n\\nSarah: Great. We also decided to increase the LinkedIn budget by 20% starting next month. Alice, please update the media plan accordingly.\\n\\nAlice: Noted, I will update the media plan by Wednesday.\\n\\nSarah: Perfect. Let us reconvene next Tuesday to review the updated plan.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('response has required fields', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('title');",
                  "  pm.expect(body).to.have.property('summary');",
                  "  pm.expect(body).to.have.property('action_items').that.is.an('array');",
                  "  pm.expect(body).to.have.property('key_decisions').that.is.an('array');",
                  "  pm.expect(body).to.have.property('created_at');",
                  "});",
                  "",
                  "pm.test('action items have correct shape', () => {",
                  "  const body = pm.response.json();",
                  "  body.action_items.forEach(item => {",
                  "    pm.expect(item).to.have.property('id');",
                  "    pm.expect(item).to.have.property('task');",
                  "    pm.expect(item).to.have.property('owner');",
                  "    pm.expect(item).to.have.property('deadline');",
                  "  });",
                  "});",
                  "",
                  "// Capture IDs for downstream requests",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('meetingId', body.id);",
                  "if (body.action_items.length > 0) {",
                  "  pm.collectionVariables.set('actionItemId', body.action_items[0].id);",
                  "}",
                  "if (body.key_decisions.length > 0) {",
                  "  pm.collectionVariables.set('keyDecisionId', body.key_decisions[0].id);",
                  "}",
                  "console.log('meetingId set to', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/process — transcript too short (422)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/process",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Short Test\",\n  \"transcript\": \"Too short.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('error code transcript_too_short', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('transcript_too_short');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/process — missing title (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/process",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transcript\": \"Sarah: Good morning everyone. Today we are reviewing the Q2 Meta campaign performance and deciding on budget reallocation for Q3. John will prepare the brief by Friday. Alice will update the media plan.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error field present', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('error');",
                  "  pm.expect(body).to.have.property('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Meetings",
      "item": [
        {
          "name": "GET /api/meetings — list",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/meetings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('array');",
                  "});",
                  "pm.test('items have id, title, summary, created_at', () => {",
                  "  const body = pm.response.json();",
                  "  if (body.length > 0) {",
                  "    const item = body[0];",
                  "    pm.expect(item).to.have.property('id');",
                  "    pm.expect(item).to.have.property('title');",
                  "    pm.expect(item).to.have.property('summary');",
                  "    pm.expect(item).to.have.property('created_at');",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/meetings/:id — full meeting",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('full meeting shape', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.id).to.eql(pm.collectionVariables.get('meetingId'));",
                  "  pm.expect(body).to.have.property('action_items').that.is.an('array');",
                  "  pm.expect(body).to.have.property('key_decisions').that.is.an('array');",
                  "  pm.expect(body).to.have.property('raw_transcript');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/meetings/:id — not found (404)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/meetings/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error not_found', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('not_found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /api/meetings/:id — edit title + summary",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q2 Campaign Review (Edited)\",\n  \"summary\": \"The team reviewed Q2 Meta performance and decided to pause Google Ads pending new creatives. LinkedIn budget will increase 20% next month.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('title was updated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.title).to.eql('Q2 Campaign Review (Edited)');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /api/meetings/:id — no fields (400)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('error no_changes', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('no_changes');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Action Items",
      "item": [
        {
          "name": "POST /api/meetings/:id/action-items — add item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/action-items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Send updated media plan to client\",\n  \"owner\": \"Alice\",\n  \"deadline\": \"Thursday\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('returned item has id', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body.task).to.eql('Send updated media plan to client');",
                  "  pm.expect(body.owner).to.eql('Alice');",
                  "  pm.expect(body.deadline).to.eql('Thursday');",
                  "  // overwrite so downstream tests use this manually-added item",
                  "  pm.collectionVariables.set('actionItemId', body.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /api/action-items/:id — edit item",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/action-items/{{actionItemId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Send updated media plan to client (revised)\",\n  \"owner\": \"Alice\",\n  \"deadline\": \"Friday\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('deadline updated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.deadline).to.eql('Friday');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /api/action-items/:id — null out owner",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/action-items/{{actionItemId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('owner is null', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.owner).to.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /api/action-items/:id",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/action-items/{{actionItemId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200 or 204', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /api/action-items/:id — not found (404)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/action-items/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error not_found', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('not_found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Key Decisions",
      "item": [
        {
          "name": "POST /api/meetings/:id/key-decisions — add decision",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/meetings/{{meetingId}}/key-decisions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Decided to consolidate all paid social under one agency.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('returned decision has id and text', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body.text).to.eql('Decided to consolidate all paid social under one agency.');",
                  "  pm.collectionVariables.set('keyDecisionId', body.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PATCH /api/key-decisions/:id — edit decision",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/key-decisions/{{keyDecisionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Decided to consolidate all paid social under one agency effective Q3.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('text was updated', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.text).to.include('effective Q3');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /api/key-decisions/:id",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/key-decisions/{{keyDecisionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200 or 204', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /api/key-decisions/:id — not found (404)",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/key-decisions/does-not-exist"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('error not_found', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('not_found');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
